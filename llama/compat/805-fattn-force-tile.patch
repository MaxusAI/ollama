+// MAXUSAI (experiment, not for shipping): isolate the MMA kernel's value.
+//
+// The AMD WMMA branch excludes head_dim 40 and 72 outright and caps at 256, so
+// both gemma4 models run entirely on TILE -- the tower because 1152/16 = 72 is
+// on the exclusion list, the LM because 512 exceeds the cap. Whether that
+// costs anything on gfx1151 has never been measured here.
+//
+// Forcing TILE on a model that WOULD get MMA isolates the kernel from every
+// model difference. The reverse (forcing MMA at head_dim 72) is not offered:
+// the kernel is templated on head size and there is no instantiation for it,
+// so it would abort rather than measure.
+//
+// Gated so one build A/Bs at runtime; unset leaves upstream behaviour exact.
+static best_fattn_kernel ggml_cuda_get_best_fattn_kernel_impl(const int device, const ggml_tensor * dst);
+
 static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const ggml_tensor * dst) {
+    const best_fattn_kernel k = ggml_cuda_get_best_fattn_kernel_impl(device, dst);
+    if (k == BEST_FATTN_KERNEL_MMA_F16) {
+        const char * e = getenv("GGML_CUDA_FATTN_FORCE_TILE");
+        if (e && (e[0] == '1' || e[0] == 'y' || e[0] == 'Y')) {
+            // Announce ONCE. A gate that silently does nothing is
+            // indistinguishable from a gate that works and changes nothing,
+            // and the measured deltas here are smaller than run-to-run drift.
+            static bool announced = false;
+            if (!announced) {
+                announced = true;
+                GGML_LOG_ERROR("FATTN_FORCE_TILE: overriding MMA_F16 -> TILE\n");
+            }
+            return BEST_FATTN_KERNEL_TILE;
+        }
+    }
+    return k;
+}
+
+static best_fattn_kernel ggml_cuda_get_best_fattn_kernel_impl(const int device, const ggml_tensor * dst) {
 #ifndef FLASH_ATTN_AVAILABLE
     GGML_UNUSED(device); GGML_UNUSED(dst);
