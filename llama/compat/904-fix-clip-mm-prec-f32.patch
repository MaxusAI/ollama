+// MAXUSAI: force fp32 accumulation on the graph's f16-weight matmuls.
+// With default precision, CUDA/HIP run f16-weight GGML_OP_MUL_MAT through
+// cuBLAS with 16F compute, and the fp16 partial sums can overflow for
+// specific inputs (qwen2.5vl-3b poison images: degenerate '?'x31 decode plus
+// a poisoned slot), while the CPU backend always accumulates in fp32 and
+// serves the same image correctly. GGML_PREC_F32 routes those GEMMs to fp32
+// compute, matching CPU numerics. Applied as a post-pass over the built
+// graph so it covers every matmul no matter how it was constructed
+// (build_mm, direct ggml_mul_mat calls, ggml_conv_2d lowering, per-model
+// build_mm overrides). Diagnosis:
+// docs/maxusai/qwen25vl-3b-poison-image-garbage-decode.md.
+// OLLAMA_CLIP_MM_PREC=f16 restores the upstream behavior for A/B runs.
+static ggml_cgraph * clip_graph_force_mm_prec_f32(ggml_cgraph * gf) {
+    static const bool keep_f16 = [] {
+        const char * v = std::getenv("OLLAMA_CLIP_MM_PREC");
+        const bool f16 = v != nullptr && strcmp(v, "f16") == 0;
+        LOG_INF("clip_graph_force_mm_prec_f32: f16-weight matmul accumulation: %s\n",
+                f16 ? "f16 (legacy, OLLAMA_CLIP_MM_PREC=f16)" : "forced fp32");
+        return f16;
+    }();
+    if (keep_f16) {
+        return gf;
+    }
+    for (int i = 0; i < ggml_graph_n_nodes(gf); i++) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        if (node->op == GGML_OP_MUL_MAT && node->src[0] != nullptr && node->src[0]->type == GGML_TYPE_F16) {
+            ggml_mul_mat_set_prec(node, GGML_PREC_F32);
+        }
+    }
+    return gf;
+}
