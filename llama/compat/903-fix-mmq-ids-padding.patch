+GGML_CUDA_MMQ_Y_TILE_GUARD(ampere)
+GGML_CUDA_MMQ_Y_TILE_GUARD(blackwell)
+GGML_CUDA_MMQ_Y_TILE_GUARD(gcn)
+GGML_CUDA_MMQ_Y_TILE_GUARD(cdna)
+GGML_CUDA_MMQ_Y_TILE_GUARD(rdna2)
+GGML_CUDA_MMQ_Y_TILE_GUARD(rdna3)
