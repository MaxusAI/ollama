+
+// MAXUSAI (compat 903): a compile-time guard on the src1 tail padding. For every config table and ggml type it
+// requires that ggml_cuda_mmq_get_J_pad() -- the function the allocation above calls -- covers the y load of every
+// config of that table, so a change that re-tightens the padding, or a config that outgrows it, fails the build on
+// every architecture's table at once, with no GPU. The requirement is written from the kernel's load loop
+// (GGML_PAD(J*MMQ_TILE_Y_K, nthreads) ints from a tile's first column, one block of which is data), not from the
+// padding helpers, so it stays independent of them. One static_assert per (table, type) keeps each constant
+// evaluation well inside the compilers' step limits; it runs in the host pass only, once per build. HIP must key
+// off __HIP_DEVICE_COMPILE__: vendors/hip.h defines __CUDA_ARCH__ in every HIP pass, host included, so testing
+// __CUDA_ARCH__ there compiles the guard out silently. MUSA is left out: the fork does not build it.
+// It cannot see the call sites: the allocations above must keep using J_pad.
+#if defined(GGML_USE_HIP)
+#    if !defined(__HIP_DEVICE_COMPILE__)
+#        define GGML_CUDA_MMQ_PADDING_GUARD_ON
+#    endif
+#elif !defined(GGML_USE_MUSA) && !defined(__CUDA_ARCH__)
+#    define GGML_CUDA_MMQ_PADDING_GUARD_ON
+#endif
+#ifdef GGML_CUDA_MMQ_PADDING_GUARD_ON
+#define GGML_CUDA_MMQ_PADDING_GUARD(TABLE)                                                                              \
+    static constexpr bool ggml_cuda_mmq_padding_ok_##TABLE(const int t) {                                               \
+        for (int fb = 0; fb < 2; ++fb) {                                                                                \
+            const int64_t J_pad = ggml_cuda_mmq_get_J_pad([t, fb](const int J) {                                        \
+                return ggml_cuda_mmq_get_config_##TABLE((ggml_type) t, J, fb);                                          \
+            });                                                                                                         \
+            for (int J = 8; J <= 128; J += 8) {                                                                         \
+                const ggml_cuda_mmq_config c = ggml_cuda_mmq_get_config_##TABLE((ggml_type) t, J, fb);                  \
+                if (c.type == GGML_TYPE_COUNT) {                                                                        \
+                    continue;                                                                                           \
+                }                                                                                                       \
+                const size_t y_load = GGML_PAD(c.J*MMQ_TILE_Y_K, c.nthreads)*sizeof(int);                               \
+                if (size_t(J_pad)*sizeof(block_q8_1_mmq) + sizeof(block_q8_1_mmq) < y_load) {                          \
+                    return false;                                                                                       \
+                }                                                                                                       \
+            }                                                                                                           \
+        }                                                                                                               \
+        return true;                                                                                                    \
+    }                                                                                                                   \
+    template <int t> struct ggml_cuda_mmq_padding_guard_##TABLE {                                                       \
+        static_assert(ggml_cuda_mmq_padding_ok_##TABLE(t),                                                              \
+            "compat 903: MMQ src1 padding is short for a config in the " #TABLE " table");                              \
+    };                                                                                                                  \
+    template <int... ts> static constexpr size_t ggml_cuda_mmq_padding_all_##TABLE(std::integer_sequence<int, ts...>) { \
+        return (sizeof(ggml_cuda_mmq_padding_guard_##TABLE<ts>) + ... + 0);                                             \
+    }                                                                                                                   \
+    static_assert(ggml_cuda_mmq_padding_all_##TABLE(std::make_integer_sequence<int, GGML_TYPE_COUNT>()) > 0, "");
+
+GGML_CUDA_MMQ_PADDING_GUARD(pascal_older)
+GGML_CUDA_MMQ_PADDING_GUARD(pascal_dp4a)
+GGML_CUDA_MMQ_PADDING_GUARD(ampere)
+GGML_CUDA_MMQ_PADDING_GUARD(blackwell)
+GGML_CUDA_MMQ_PADDING_GUARD(gcn)
+GGML_CUDA_MMQ_PADDING_GUARD(cdna)
+GGML_CUDA_MMQ_PADDING_GUARD(rdna2)
+GGML_CUDA_MMQ_PADDING_GUARD(rdna3)
+GGML_CUDA_MMQ_PADDING_GUARD(rdna3_5)
+GGML_CUDA_MMQ_PADDING_GUARD(rdna4)
+
+#undef GGML_CUDA_MMQ_PADDING_GUARD
+#undef GGML_CUDA_MMQ_PADDING_GUARD_ON
+#endif // GGML_CUDA_MMQ_PADDING_GUARD_ON
diff --git a/ggml/src/ggml-cuda/mmq.cuh b/ggml/src/ggml-cuda/mmq.cuh
index 0cd31d9..2781926 100644
--- a/ggml/src/ggml-cuda/mmq.cuh
+++ b/ggml/src/ggml-cuda/mmq.cuh
@@ -1393,11 +1393,35 @@ struct mmq_args {
     int64_t ncols_opt; // value to optimize the tile size against, launch grid still uses ncols_max
 };
 
+// MAXUSAI (compat 903): the bytes of src1 one tile's y load copies, starting at the tile's first column. The load in
+// mul_mat_q_process_tile runs to the next multiple of nthreads ints with no bound on the column count, so it fills
+// the whole shared-memory y tile: one expression sizes that tile and the global padding below.
+static constexpr __host__ __device__ size_t ggml_cuda_mmq_get_nbytes_y_tile(const ggml_cuda_mmq_config & config) {
+    return GGML_PAD(config.J*sizeof(block_q8_1_mmq), config.nthreads*sizeof(int));
+}
+
 static size_t mmq_get_nbytes_shared(const ggml_cuda_mmq_config & config, const int cc) {
     const size_t nbs_ids = config.J*sizeof(int);
     const size_t nbs_x = ggml_cuda_mmq_get_nbytes_shared_x(config, cc);
-    const size_t nbs_y = config.J * (sizeof(block_q8_1_mmq));
-    return nbs_ids + nbs_x + GGML_PAD(nbs_y, config.nthreads*sizeof(int));
+    return nbs_ids + nbs_x + ggml_cuda_mmq_get_nbytes_y_tile(config);
+}
+
+// MAXUSAI (compat 903): the src1 tail padding, in blocks of block_q8_1_mmq: the widest y tile of any config for one
+// (type, fallback). A launch's last tile may hold a single column -- for MUL_MAT_ID the last expert may hold a single
+// row, at any batch size -- and then reads its whole y tile less one block past the data, so padding for the widest
+// one covers every J a launch can pick. Floored: floor(T/B) blocks always cover the T - B bytes read.
+// get_config(J) supplies the configs: the device's dispatch at run time, one config table in mmq.cu's guard, which
+// is why this is generic rather than taking a cc.
+template <typename get_config_t>
+static constexpr int64_t ggml_cuda_mmq_get_J_pad(const get_config_t & get_config) {
+    size_t nbytes = 0;
+    for (int J = 8; J <= 128; J += 8) {
+        const ggml_cuda_mmq_config config = get_config(J);
+        if (config.type != GGML_TYPE_COUNT && ggml_cuda_mmq_get_nbytes_y_tile(config) > nbytes) {
+            nbytes = ggml_cuda_mmq_get_nbytes_y_tile(config);
+        }
+    }
+    return nbytes / sizeof(block_q8_1_mmq);
 }
 
 template <ggml_type type, int J, bool fallback, ggml_prec prec_src1 = GGML_PREC_Q8>
