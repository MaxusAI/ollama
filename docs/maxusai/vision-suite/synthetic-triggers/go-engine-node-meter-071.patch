+// MAXUSAI (diagnostic, not for shipping): continuous meter on one vision
+// block's ffn_down output. 0.7.1 runs the Go engine -- no clip graph, no
+// libmtmd -- so the libmtmd node meter cannot be loaded here; this is its
+// equivalent. Its vendored ggml has no GGML_CUDA_CUBLAS_COMPUTE_TYPE knob
+// (cu_compute_type is hardcoded CUBLAS_COMPUTE_16F), so run this on the CPU
+// backend, which accumulates in f32, to read magnitude without overflowing.
+// Enable with OLLAMA_VISION_METER_LAYER=<block index>.
+var (
+	meterLayer   = -1
+	meterCurrent int
+	meterTensor  ml.Tensor
+)
