+
+// reportVisionMeter computes the captured ffn_down output on its own and
+// prints magnitude statistics. fp16 max is 65504, so hr >= 1 means an fp16
+// accumulator cannot represent the result.
+func reportVisionMeter(ctx ml.Context) {
+	if meterTensor == nil {
+		return
+	}
+	t := meterTensor
+	meterTensor = nil
+	// Compute() calls ggml_backend_sched_reset() straight after dispatch, which
+	// releases the graph allocator's intermediate buffers. On CPU the host
+	// allocation still holds the values, but on CUDA the binding is dead and the
+	// readback returns zeros. Copy into an Input()-allocated tensor first: that
+	// lives in a persistent buffer, so it survives the reset and is readable on
+	// both backends. Same idiom as ml.Backend's own f32 conversion path.
+	dst := ctx.Input().Empty(ml.DTypeF32, t.Shape()...)
+	dst = t.Copy(ctx, dst)
+	ctx.Forward(dst).Compute(dst)
+	f := dst.Floats()
+	var mx float32
+	var nInf, n60, n49 int
+	for _, x := range f {
+		a := float32(math.Abs(float64(x)))
+		if math.IsInf(float64(x), 0) || math.IsNaN(float64(x)) {
+			nInf++
+			continue
+		}
+		if a > mx {
+			mx = a
+		}
+		if a > 60000 {
+			n60++
+		}
+		if a > 49128 {
+			n49++
+		}
+	}
+	fmt.Fprintf(os.Stderr, "GO_NODE_STATS layer=%d n=%d max_abs=%.1f hr=%.4f n_gt49k=%d n_gt60k=%d n_bad=%d\n",
+		meterLayer, len(f), mx, mx/65504.0, n49, n60, nInf)
+}
