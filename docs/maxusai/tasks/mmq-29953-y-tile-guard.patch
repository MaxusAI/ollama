+
+// Compile-time guard on the y tile: for every config table and type, ggml_cuda_mmq_get_nbytes_y_tile() -- which
+// sizes both the shared-memory y tile and the global src1 padding -- must cover the y load in
+// mul_mat_q_process_tile, which runs l0 over [0, J*MMQ_TILE_Y_K) in steps of nthreads ints with no bound on l.
+// The requirement is written from that loop with exact ceiling division, not from the helper or GGML_PAD, so a
+// change to either side that makes them disagree fails the build for every architecture's table at once, with no
+// GPU. One static_assert per (table, type) keeps each constant evaluation small. HIP keys off
+// __HIP_DEVICE_COMPILE__ because vendors/hip.h defines __CUDA_ARCH__ in every HIP pass, host included.
+#if defined(GGML_USE_HIP)
+#    if !defined(__HIP_DEVICE_COMPILE__)
+#        define GGML_CUDA_MMQ_Y_TILE_GUARD_ON
+#    endif
+#elif !defined(GGML_USE_MUSA) && !defined(__CUDA_ARCH__)
+#    define GGML_CUDA_MMQ_Y_TILE_GUARD_ON
+#endif
+#ifdef GGML_CUDA_MMQ_Y_TILE_GUARD_ON
+#define GGML_CUDA_MMQ_Y_TILE_GUARD(TABLE)                                                                               \
+    static constexpr bool ggml_cuda_mmq_y_tile_ok_##TABLE(const int t) {                                                \
+        for (int fb = 0; fb < 2; ++fb) {                                                                                \
+            for (int J = 8; J <= 128; J += 8) {                                                                         \
+                const ggml_cuda_mmq_config c = ggml_cuda_mmq_get_config_##TABLE((ggml_type) t, J, fb);                  \
+                if (c.type == GGML_TYPE_COUNT) {                                                                        \
+                    continue;                                                                                           \
+                }                                                                                                       \
+                const size_t y_load = size_t((c.J*MMQ_TILE_Y_K + c.nthreads - 1) / c.nthreads) * c.nthreads * sizeof(int); \
+                if (ggml_cuda_mmq_get_nbytes_y_tile(c) < y_load) {                                                      \
+                    return false;                                                                                       \
+                }                                                                                                       \
+            }                                                                                                           \
+        }                                                                                                               \
+        return true;                                                                                                    \
+    }                                                                                                                   \
+    template <int t> struct ggml_cuda_mmq_y_tile_guard_##TABLE {                                                        \
+        static_assert(ggml_cuda_mmq_y_tile_ok_##TABLE(t),                                                               \
+            "MMQ: the y tile helper is smaller than the y load for a config in the " #TABLE " table");                 \
+    };                                                                                                                  \
+    template <typename> struct ggml_cuda_mmq_y_tile_guards_##TABLE;                                                     \
+    template <int... ts> struct ggml_cuda_mmq_y_tile_guards_##TABLE<std::integer_sequence<int, ts...>>                  \
+        : ggml_cuda_mmq_y_tile_guard_##TABLE<ts>... {};                                                                 \
+    template struct ggml_cuda_mmq_y_tile_guards_##TABLE<std::make_integer_sequence<int, GGML_TYPE_COUNT>>;
+
+GGML_CUDA_MMQ_Y_TILE_GUARD(pascal_older)
+GGML_CUDA_MMQ_Y_TILE_GUARD(pascal_dp4a)
+GGML_CUDA_MMQ_Y_TILE_GUARD(ampere)
+GGML_CUDA_MMQ_Y_TILE_GUARD(blackwell)
+GGML_CUDA_MMQ_Y_TILE_GUARD(gcn)
+GGML_CUDA_MMQ_Y_TILE_GUARD(cdna)
+GGML_CUDA_MMQ_Y_TILE_GUARD(rdna2)
+GGML_CUDA_MMQ_Y_TILE_GUARD(rdna3)
+GGML_CUDA_MMQ_Y_TILE_GUARD(rdna3_5)
+GGML_CUDA_MMQ_Y_TILE_GUARD(rdna4)
+
+#undef GGML_CUDA_MMQ_Y_TILE_GUARD
+#undef GGML_CUDA_MMQ_Y_TILE_GUARD_ON
+#endif // GGML_CUDA_MMQ_Y_TILE_GUARD_ON
